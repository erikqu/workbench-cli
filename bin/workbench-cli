#!/usr/bin/env bash
set -euo pipefail

# Resolve this script through any symlinks (e.g. ~/.local/bin/workbench-cli).
INVOKED_SOURCE="${BASH_SOURCE[0]}"
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$DIR/$TARGET"
  fi
done

BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# Package root holds the workbench-ui workbench.
PKG_DIR="$(cd -P "$BIN_DIR/.." && pwd)"
UI_DIR="$PKG_DIR/workbench-ui"

update_help() {
  cat <<'EOF'
Usage: workbench-cli update

Update this Workbench CLI installation and reinstall its dependencies.
The short `work update` form works too.
EOF
}

if [[ "${1:-}" == "update" ]]; then
  shift
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    update_help
    exit 0
  fi
  if (( $# > 0 )); then
    echo "workbench-cli update does not accept arguments." >&2
    update_help >&2
    exit 2
  fi
  if ! command -v git >/dev/null 2>&1; then
    echo "workbench-cli update requires git on PATH." >&2
    exit 1
  fi
  if [[ ! -f "$PKG_DIR/install.sh" || ! -d "$PKG_DIR/.git" ]]; then
    echo "This Workbench installation cannot update itself: $PKG_DIR is not a source checkout." >&2
    echo "Reinstall with: curl -fsSL https://ehq.so/install | bash" >&2
    exit 1
  fi
  if [[ -n "$(git -C "$PKG_DIR" status --porcelain --untracked-files=normal)" ]]; then
    echo "Refusing to update because $PKG_DIR has local changes." >&2
    echo "Commit, stash, or remove those changes, then run workbench-cli update again." >&2
    exit 1
  fi

  update_bin_dir="${WORKBENCH_CLI_BIN:-$HOME/.local/bin}"
  if [[ -L "$INVOKED_SOURCE" ]]; then
    update_bin_dir="$(cd -P "$(dirname "$INVOKED_SOURCE")" && pwd)"
  fi
  echo "Updating Workbench CLI in $PKG_DIR ..."
  exec env \
    WORKBENCH_CLI_HOME="$PKG_DIR" \
    WORKBENCH_CLI_BIN="$update_bin_dir" \
    bash "$PKG_DIR/install.sh"
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "workbench-cli requires bun on PATH." >&2
  exit 1
fi

# Silvery's Scope class extends AsyncDisposableStack while its module is being
# evaluated. Detect an old Bun here so users get a useful recovery instruction
# instead of a dependency stack trace.
if ! bun -e 'process.exit(typeof AsyncDisposableStack === "function" ? 0 : 1)' >/dev/null 2>&1; then
  echo "workbench-cli requires a newer Bun (found $(bun --version))." >&2
  echo "Upgrade Bun or re-run: curl -fsSL https://ehq.so/install | bash" >&2
  exit 1
fi

if [[ ! -d "$UI_DIR" ]]; then
  echo "Missing workbench-ui directory: $UI_DIR" >&2
  exit 1
fi

# Hot reload (opt-in): restart the workbench whenever its TypeScript source
# changes, so edits or updates to workbench-cli take effect without a manual
# relaunch. Enable with WORKBENCH_CLI_HOT=1 or by passing --hot (aliases: --dev,
# --watch).
#
# The application-owned hot runner watches source files, sends SIGTERM to the
# current UI, waits for it to save and detach, then launches the replacement.
# Do not replace it with Bun's native --watch: native watch restarts do not
# guarantee Workbench's shutdown handoff and can reset active coding sessions.
hot="${WORKBENCH_CLI_HOT:-0}"
terminal_trace="${WORKBENCH_TERMINAL_TRACE:-0}"
args=()
for arg in "$@"; do
  case "$arg" in
    --hot | --dev | --watch) hot=1 ;;
    --terminal-trace) terminal_trace=1 ;;
    *) args+=("$arg") ;;
  esac
done

entry="$UI_DIR/src/index.ts"
if [[ "$hot" == "1" ]]; then
  # Hot reload exists for developing workbench-cli itself, but the `work`
  # symlink resolves to the installed checkout (~/.local/share/workbench-cli),
  # whose hot runner would run and watch ITS OWN sources — edits in a dev
  # checkout would neither run nor trigger reloads. When the current directory
  # is inside a different workbench-cli source checkout, run and watch that
  # checkout instead. Override the detection with WORKBENCH_CLI_HOT_ROOT.
  hot_root="${WORKBENCH_CLI_HOT_ROOT:-}"
  if [[ -z "$hot_root" ]]; then
    probe_dir="$PWD"
    while [[ "$probe_dir" != "/" ]]; do
      if [[ -f "$probe_dir/workbench-ui/src/index.ts" && -f "$probe_dir/bin/workbench-cli" ]]; then
        hot_root="$probe_dir"
        break
      fi
      probe_dir="$(dirname "$probe_dir")"
    done
  fi
  if [[ -n "$hot_root" && "$hot_root" != "$PKG_DIR" ]]; then
    if [[ -d "$hot_root/workbench-ui/node_modules/silvery" ]]; then
      echo "workbench-cli --hot: running source checkout $hot_root" >&2
      UI_DIR="$hot_root/workbench-ui"
    else
      echo "workbench-cli --hot: found source checkout $hot_root but its dependencies are missing." >&2
      echo "Run: cd $hot_root/workbench-ui && bun install    (falling back to $PKG_DIR)" >&2
    fi
  fi
  entry="$UI_DIR/scripts/hot-runner.ts"
fi

exec env -u NO_COLOR \
  COLORTERM="${COLORTERM:-truecolor}" \
  FORCE_COLOR=1 \
  WORKBENCH_CLI_HOT="$hot" \
  WORKBENCH_TERMINAL_TRACE="$terminal_trace" \
  WORKBENCH_UI_CWD="${WORKBENCH_UI_CWD:-$PWD}" \
  bun "$entry" ${args[@]+"${args[@]}"}
